---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { events } from '../../../data/events';
const cafes = events.filter((event) => event.series === 'Café');
const posters = [
  { id: '#001 | JP', heading: 'Japanese Café poster', copy: 'The first Café brings together real AI practices among experimental researchers in Japanese.', detail: '/en/events/cafe-001-jp/', image: '/images/research-ai-cafe-001-jp-poster.webp', alt: 'Research AI Café #001 Japanese poster. Date, venue, and registration details are TBD.' },
  { id: '#002 | EN', heading: 'English Café poster', copy: 'Café #002 explores the same theme in English, including differences across research fields and cultures.', detail: '/en/events/cafe-002-en/', image: '/images/research-ai-cafe-002-en-poster.webp', alt: 'Research AI Café #002 English poster. The theme is How are you using AI in your research? Date, venue, and registration details are TBD.' },
];
---
<BaseLayout lang="en" title="Café | Research AI Commons"><section class="section"><div class="container"><div class="eyebrow">Research AI Café</div><h1 style="font-size:clamp(2.5rem,6vw,4.7rem)">Start by talking<br/>with other researchers.</h1><p class="lead">The Café is a small, informal, recurring gathering. No specialist knowledge or advance preparation is required.</p><div class="event-list">{cafes.map((event) => <article class="card event"><div><div class="event-id">Café {event.id}</div><span class="pill">{event.language}</span></div><div><h3>{event.titleEn}</h3><p>{event.summaryEn}</p><div class="event-meta">Date: TBD / Venue: TBD</div></div><a class="button secondary" href={event.hrefEn}>Details</a></article>)}</div>
{posters.map((poster) => <section class="poster-section"><div class="poster-copy"><div class="eyebrow">Café {poster.id} Poster</div><h2>{poster.heading}</h2><p>{poster.copy}</p><a class="button secondary" href={poster.detail}>View event details</a></div><a class="poster-link" href={poster.image} aria-label={`Open the Café ${poster.id} poster at full size`}><img src={poster.image} alt={poster.alt} width="900" height="1274" loading="lazy" /></a></section>)}
</div></section></BaseLayout>
<style>.event-list{display:grid;gap:16px;margin-top:32px}.poster-section{display:grid;grid-template-columns:minmax(240px,.72fr) minmax(300px,1fr);gap:clamp(32px,6vw,76px);align-items:start;margin-top:clamp(70px,9vw,112px);padding-top:clamp(54px,7vw,80px);border-top:1px solid var(--line)}.poster-copy{position:sticky;top:104px}.poster-copy p{color:var(--muted);margin-bottom:24px}.poster-link{display:block;background:var(--surface);border:1px solid var(--line);padding:10px;box-shadow:var(--shadow);transition:transform .18s ease,box-shadow .18s ease}.poster-link:hover{transform:translateY(-3px);box-shadow:var(--shadow-deep)}.poster-link img{display:block;width:100%;height:auto}@media(max-width:820px){.poster-section{grid-template-columns:1fr}.poster-copy{position:static}.poster-link{max-width:620px}}@media(prefers-reduced-motion:reduce){.poster-link{transition:none}}</style>
