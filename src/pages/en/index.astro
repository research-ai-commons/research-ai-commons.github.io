---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { events } from '../../data/events';
const upcoming = events.filter((event) => event.series === 'Café');
---
<BaseLayout lang="en" title={`${site.name} — ${site.tagline}`} description="A researcher-led community for sharing real AI practices across labs and disciplines.">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy"><div class="eyebrow">Researcher-led community</div><h1>Real AI practice,<br/>shared <span>beyond<br/>the lab.</span></h1><p class="lead">Research AI Commons is a researcher-led community where people share how AI is actually used in research across labs and disciplines—including successes, failures, risks, uncertainties, and open questions.</p><div class="actions"><a class="button" href="/en/cafe/">See Café events <span aria-hidden="true">→</span></a><a class="button secondary" href="/en/about/">Read our principles</a></div></div>
      <aside class="field-note" aria-label="Community focus"><div class="note-label">Field note / 001</div><p class="quote">“How is AI <em>actually</em> changing your research?”</p><dl><div><dt>Focus</dt><dd>Real workflows</dd></div><div><dt>Origin</dt><dd>Experimental research</dd></div><div><dt>Method</dt><dd>Share · Question · Reflect</dd></div></dl><div class="note-footer">{site.tagline}</div></aside>
    </div>
    <div class="container scope-line" aria-label="Community scope"><span>Experiments</span><span>Literature</span><span>Coding</span><span>Data</span><span>Writing</span><span>Research culture</span></div>
  </section>
  <section class="section intro-section"><div class="container intro-grid"><div><div class="eyebrow">Why we gather</div><h2>Start with research,<br/>not the tools.</h2></div><div class="intro-copy"><p class="lead">Lectures about AI are becoming common, but practical knowledge about how researchers use, question, verify, or avoid AI often remains inside individual labs.</p><a class="text-link" href="/en/about/">Learn more about the community <span aria-hidden="true">↗</span></a></div></div></section>
  <section class="section"><div class="container"><div class="eyebrow">What we do</div><h2>Talk. Go deeper. Share back.</h2><div class="grid"><article class="card"><div class="card-index">01</div><span class="pill">Café</span><h3>Bring real experience together</h3><p>Small, informal conversations about where AI helps, where it fails, and what feels risky in daily research.</p></article><article class="card"><div class="card-index">02</div><span class="pill">Forum</span><h3>Explore questions with specialists</h3><p>Structured discussions with researchers and specialists around questions that emerge from the Café.</p></article><article class="card"><div class="card-index">03</div><span class="pill">Resources</span><h3>Return insights to the community</h3><p>We organize and publish reusable, appropriately anonymized insights from events and research practice.</p></article></div></div></section>
  <section class="section band"><div class="container loop-grid"><div><div class="eyebrow light">Our loop</div><h2>Find questions.<br/>Bring them back.</h2></div><ol class="loop" aria-label="Community feedback loop"><li><span>01</span>Café</li><li><span>02</span>Questions</li><li><span>03</span>Forum</li><li><span>04</span>Reflection</li><li><span>05</span>Publication</li></ol><p class="lead loop-copy">We identify questions in real research settings, connect them with relevant expertise, and bring the resulting insights back to research practice.</p></div></section>
  <section class="section"><div class="container"><div class="eyebrow">Upcoming events</div><h2>Next Cafés</h2><div class="event-list">{upcoming.map((event) => <article class="card event"><div><div class="event-id">Research AI {event.series} {event.id}</div><div><span class="pill">{event.language}</span><span class="pill status">Planning</span></div></div><div><h3>{event.titleEn}</h3><p>{event.summaryEn}</p><div class="event-meta">Date: TBD<br/>Venue: TBD</div></div><a class="button secondary" href={event.hrefEn}>Details <span aria-hidden="true">→</span></a></article>)}</div></div></section>
  <section class="section"><div class="container kicker-grid"><div class="kicker"><h3>This is not a space for promoting AI.</h3><p>Research comes first; AI is one possible means. We remain neutral toward particular tools and companies.</p></div><div class="kicker"><h3>“It failed” is valuable knowledge.</h3><p>Plausible errors, unsafe code, verification costs, and other failures belong in the conversation too.</p></div></div></section>
</BaseLayout>
<style>
.hero-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(300px,.65fr);gap:clamp(42px,7vw,92px);align-items:center}.hero h1 span{color:var(--primary)}.field-note{background:var(--ink);color:#fff;padding:30px;border-radius:4px 34px 4px 4px;box-shadow:var(--shadow-deep);transform:rotate(1.3deg);position:relative;overflow:hidden}.field-note::before{content:'';position:absolute;inset:0;background:linear-gradient(transparent 31px,rgba(255,255,255,.07) 32px);background-size:100% 32px;pointer-events:none}.note-label,.note-footer{position:relative;font:700 .7rem var(--mono);letter-spacing:.09em;text-transform:uppercase;color:var(--mint)}.quote{position:relative;font-size:clamp(1.5rem,3vw,2.35rem);line-height:1.18;font-weight:760;letter-spacing:-.035em;margin:42px 0 36px}.quote em{font-family:Georgia,serif;font-weight:400;color:var(--mint)}.field-note dl{position:relative;margin:0}.field-note dl div{display:grid;grid-template-columns:85px 1fr;padding:10px 0;border-top:1px solid rgba(255,255,255,.16)}.field-note dt{font:600 .68rem var(--mono);text-transform:uppercase;color:#a7bbb8}.field-note dd{margin:0;font-weight:650}.note-footer{margin-top:36px;color:#a7bbb8}.scope-line{display:flex;flex-wrap:wrap;gap:0;margin-top:72px;border-block:1px solid var(--line)}.scope-line span{flex:1;min-width:140px;padding:13px 16px;border-right:1px solid var(--line);font:650 .72rem var(--mono);text-align:center;text-transform:uppercase;letter-spacing:.05em}.scope-line span:last-child{border-right:0}.intro-section{background:var(--surface)}.intro-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:start}.intro-copy{padding-top:26px}.text-link{display:inline-block;margin-top:12px;color:var(--primary);font-weight:800;border-bottom:1px solid currentColor}.card{position:relative;overflow:hidden}.card-index{position:absolute;right:20px;top:15px;font:700 2.6rem var(--mono);color:var(--accent)}.loop-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:40px 70px;align-items:start}.light{color:var(--mint)}.loop{margin:0;padding:0;list-style:none;border-top:1px solid rgba(255,255,255,.2)}.loop li{display:grid;grid-template-columns:48px 1fr;padding:13px 0;border-bottom:1px solid rgba(255,255,255,.2);font-size:1.15rem;font-weight:750}.loop li span{font:600 .72rem var(--mono);color:var(--mint)}.loop-copy{grid-column:2}.status{background:var(--accent);color:var(--primary-dark);border-color:transparent}.event-list{display:grid;gap:16px}@media(max-width:900px){.hero-grid,.intro-grid,.loop-grid{grid-template-columns:1fr}.field-note{max-width:600px;transform:none}.scope-line{margin-top:50px}.loop-copy{grid-column:1}.intro-grid{gap:10px}}@media(max-width:560px){.field-note{padding:24px;border-radius:4px 26px 4px 4px}.scope-line span{min-width:50%;border-bottom:1px solid var(--line)}.scope-line span:nth-child(2n){border-right:0}}
</style>
