---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { events } from '../../data/events';
const cafes = events.filter((e) => e.series === 'Café');
---
<BaseLayout title="Café | Research AI Commons">
<section class="section"><div class="container">
<div class="eyebrow">Research AI Café</div><h1 style="font-size:clamp(2.5rem,6vw,4.7rem)">研究者どうしで、<br/>まず話してみる。</h1>
<p class="lead">Caféは、小規模でラフな継続型の交流会です。参加に専門知識や事前準備は必要ありません。</p>
<div style="height:32px"></div>
{cafes.map((event) => <article class="card event"><div><div class="event-id">Café {event.id}</div><span class="pill">{event.language}</span></div><div><h3>{event.title}</h3><p>{event.summary}</p><div class="event-meta">{event.date} / {event.time}</div></div><a class="button secondary" href={event.href}>詳細</a></article>)}

<section class="poster-section" aria-labelledby="cafe-poster-heading">
  <div class="poster-copy">
    <div class="eyebrow">Café #001 Poster</div>
    <h2 id="cafe-poster-heading">第1回Caféのポスター</h2>
    <p>「研究にAI、みんなどう使ってる？」をテーマに、実験系研究者のリアルな使い方や失敗例、気になっていることを持ち寄ります。</p>
    <a class="button secondary" href="/events/cafe-001-jp/">イベント詳細を見る</a>
  </div>
  <a class="poster-link" href="/images/research-ai-cafe-001-jp-poster.webp" aria-label="Research AI Café #001のポスターを拡大して開く">
    <img src="/images/research-ai-cafe-001-jp-poster.webp" alt="Research AI Café #001 JP。テーマは『研究にAI、みんなどう使ってる？』。日時・場所・参加方法は未定。" width="900" height="1274" loading="lazy" />
  </a>
</section>
</div></section>
</BaseLayout>

<style>
.poster-section{display:grid;grid-template-columns:minmax(240px,.72fr) minmax(300px,1fr);gap:clamp(32px,6vw,76px);align-items:start;margin-top:clamp(70px,9vw,112px);padding-top:clamp(54px,7vw,80px);border-top:1px solid var(--line)}
.poster-copy{position:sticky;top:104px}.poster-copy p{color:var(--muted);margin-bottom:24px}.poster-link{display:block;background:var(--surface);border:1px solid var(--line);padding:10px;box-shadow:var(--shadow);transition:transform .18s ease,box-shadow .18s ease}.poster-link:hover{transform:translateY(-3px);box-shadow:var(--shadow-deep)}.poster-link img{display:block;width:100%;height:auto}
@media(max-width:820px){.poster-section{grid-template-columns:1fr}.poster-copy{position:static}.poster-link{max-width:620px}}
@media(prefers-reduced-motion:reduce){.poster-link{transition:none}}
</style>
