---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Staff | Research AI Commons" description="Research AI Commonsの企画・運営メンバーを紹介します。">
  <section class="section">
    <div class="container">
      <div class="eyebrow">Staff</div>
      <h1>企画・運営</h1>
      <article class="staff-card">
        <div class="staff-index" aria-hidden="true">01</div>
        <div>
          <p class="role">企画・運営</p>
          <h2>柴垣 光希</h2>
          <p class="affiliation">北海道大学　博士3年</p>
        </div>
        <a class="button secondary" href="https://mshibagaki.github.io/index.html" target="_blank" rel="noopener noreferrer">
          個人ページを見る <span aria-hidden="true">↗</span>
        </a>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
h1{font-size:clamp(2.5rem,6vw,4.7rem);margin-bottom:42px}
.staff-card{position:relative;display:grid;grid-template-columns:1fr auto;gap:32px;align-items:end;max-width:820px;padding:clamp(28px,5vw,46px);background:var(--surface);border:1px solid var(--line);border-radius:4px 30px 4px 4px;box-shadow:var(--shadow);overflow:hidden}
.staff-index{position:absolute;right:24px;top:10px;font:700 4.5rem var(--mono);color:var(--accent)}
.role{position:relative;color:var(--primary);font:750 .8rem var(--mono);letter-spacing:.09em;text-transform:uppercase}.staff-card h2{position:relative;margin:8px 0 10px;font-size:clamp(2rem,4vw,3.3rem)}.affiliation{position:relative;color:var(--muted);font-size:1.08rem;margin:0}.staff-card .button{position:relative}
@media(max-width:660px){.staff-card{grid-template-columns:1fr;align-items:start}.staff-card .button{justify-self:start}.staff-index{font-size:3.5rem}}
</style>
