---
import { site } from '../data/site';
const { lang = 'ja', pathname = '/' } = Astro.props;
const isEnglish = lang === 'en';
const prefix = isEnglish ? '/en' : '';
const homeHref = isEnglish ? '/en/' : '/';
const languageHref = isEnglish
  ? (pathname === '/en/' ? '/' : pathname.replace(/^\/en/, ''))
  : `/en${pathname}`;
const languageLabel = isEnglish ? 'JP' : 'EN';
---
<header class="header">
  <div class="container inner">
    <a class="brand" href={homeHref} aria-label={`${site.name} home`}>
      <span class="brand-mark" aria-hidden="true">RA</span>
      <span>{site.name}</span>
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      <a href={`${prefix}/about/`}>About</a>
      <a href={`${prefix}/cafe/`}>Café</a>
      <a href={`${prefix}/forum/`}>Forum</a>
      <a href={`${prefix}/resources/`}>Resources</a>
      <a href={`${prefix}/staff/`}>Staff</a>
      <a href={`${prefix}/join/`}>Join</a>
      <a class="language" href={languageHref} lang={isEnglish ? 'ja' : 'en'}>{languageLabel}</a>
    </nav>
    <details class="mobile-menu">
      <summary aria-label={isEnglish ? 'Open menu' : 'メニューを開く'}>Menu</summary>
      <nav aria-label="Mobile navigation">
        <a href={`${prefix}/about/`}>About</a><a href={`${prefix}/cafe/`}>Café</a>
        <a href={`${prefix}/forum/`}>Forum</a><a href={`${prefix}/resources/`}>Resources</a>
        <a href={`${prefix}/staff/`}>Staff</a><a href={`${prefix}/join/`}>Join</a>
        <a href={languageHref} lang={isEnglish ? 'ja' : 'en'}>{isEnglish ? '日本語' : 'English'}</a>
      </nav>
    </details>
  </div>
</header>
<style>
.header{position:sticky;top:0;z-index:20;background:rgba(246,249,248,.94);backdrop-filter:blur(16px);border-bottom:1px solid var(--line)}
.inner{height:72px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.brand{display:flex;align-items:center;gap:11px;font-weight:850;letter-spacing:-.035em}
.brand-mark{display:grid;place-items:center;width:34px;height:34px;border-radius:9px;background:var(--ink);color:var(--mint);font-family:var(--mono);font-size:.72rem;letter-spacing:.04em}
.desktop-nav{display:flex;gap:21px;align-items:center;font-size:.91rem;font-weight:650}
.desktop-nav a{position:relative}.desktop-nav a:hover{color:var(--primary)}
.language{padding:7px 11px;border:1px solid var(--line-strong);border-radius:999px}
.mobile-menu{display:none;position:relative}.mobile-menu summary{cursor:pointer;list-style:none;padding:8px 12px;border:1px solid var(--line-strong);border-radius:999px;font:700 .85rem var(--sans)}
.mobile-menu summary::-webkit-details-marker{display:none}.mobile-menu nav{position:absolute;right:0;top:45px;width:210px;padding:10px;background:var(--surface);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);display:grid}
.mobile-menu nav a{padding:10px 12px;border-radius:9px}.mobile-menu nav a:hover{background:var(--accent)}
@media(max-width:820px){.desktop-nav{display:none}.mobile-menu{display:block}.brand span:last-child{font-size:.93rem}}
</style>
